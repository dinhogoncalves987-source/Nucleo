# ============================================================
# The Beauty Hub OS — Variáveis de Ambiente
# Copie este arquivo para .env na VPS e preencha os valores
# ============================================================

# ── Backend ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Chave secreta para autenticar o Dashboard (Vercel) com a VPS
# Gere com: openssl rand -hex 32
API_SECRET=sua_chave_secreta_aqui_32_chars_minimo

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Evolution API (100 chips) ─────────────────────────────────
EVOLUTION_API_URL=http://evolution:8080
# Gere uma chave forte: openssl rand -hex 24
EVOLUTION_API_KEY=sua_chave_evolution_aqui

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Use a Service Role Key (Admin), NÃO a anon key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...

# ── OpenAI (James Engine) ─────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Banco de Dados Supabase (para Evolution API) ─────────────
DATABASE_CONNECTION_URI=postgresql://postgres:senha@db.xxxx.supabase.co:5432/postgres

# ── Scheduler ────────────────────────────────────────────────
SCHEDULER_START_HOUR=8    # hora de inicio outbound
SCHEDULER_END_HOUR=18     # hora de fim outbound
MAX_CHIPS=100             # numero maximo de chips

# ── James Pessoal (WhatsApp de Edson) ────────────────────────
# Numero do WhatsApp de Edson (somente digitos, com DDD, sem 55)
# Exemplo: 31987654321
EDSON_PHONE=SEU_NUMERO_DDD_9_DIGITOS
