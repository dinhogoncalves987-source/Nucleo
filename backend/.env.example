# Backend runtime
NODE_ENV=
PORT=
API_SECRET=
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# OpenAI and search
OPENAI_API_KEY=
BANKER_BASE_URL=
BUBBLE_API_URL=
BUBBLE_API_TOKEN=
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Evolution and WhatsApp
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EDSON_PHONE=
MAX_CHIPS=

# Redis and queues
REDIS_URL=

# Scheduler
SCHEDULER_START_HOUR=
SCHEDULER_END_HOUR=

# Asaas
ASAAS_API_KEY=
ASAAS_SANDBOX=
ASAAS_PLATFORM_WALLET_ID=
ASAAS_CASHBACK_RATE=
ASAAS_PLATFORM_FEE=

# James: manter desligado ate aprovar modelo, credencial segura e teto de gasto.
JAMES_OPENAI_ENABLED=false
OPENAI_MODEL=

# Habilitar somente apos migration e homologacao autorizadas.
JAMES_MEMORY_ENABLED=false

# Supervised conversation entrypoint only. No credential values are configured here.
JAMES_BUDGET_ENABLED=false
JAMES_AUTH_MODE=nucleo
JAMES_PORT=3002
# Optional Qadma pilot: explicitly authorized operator/organization mapping.
QADMA_SUPABASE_URL=
QADMA_SUPABASE_PUBLISHABLE_KEY=
QADMA_PILOT_ORGANIZATION_ID=
QADMA_PILOT_USER_ID=
NUCLEO_PILOT_TENANT_ID=

# Public discovery: disabled until an operator approves a public query.
# DuckDuckGo Instant Answer is not a full web search or business directory.
PUBLIC_SEARCH_ENABLED=false
PUBLIC_SEARCH_PROVIDER=duckduckgo_instant_answer
# Google CSE also requires both GOOGLE_* values above, eligibility/quota and approved cost.
PUBLIC_SEARCH_GOOGLE_BUDGET_APPROVED=false

# Provider permission declarations only: do not enable without authorization already obtained.
# DDG historical commercial-approval requirement: current terms must also be verified.
PUBLIC_SEARCH_DDG_COMMERCIAL_APPROVED=false
# Google Custom Search JSON API: existing eligible customers only; stops 2027-01-01 UTC.
PUBLIC_SEARCH_GOOGLE_LEGACY_CUSTOMER=false
